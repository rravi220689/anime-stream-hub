<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Row 1: Title & Quality Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTaskTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            tools:text="One Piece Episode 1" />

        <TextView
            android:id="@+id/tvTaskBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:backgroundTint="#2600F0FF"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/accent_cyan"
            android:textSize="11sp"
            tools:text="1080p FHD" />
    </LinearLayout>

    <!-- Row 2: File Name -->
    <TextView
        android:id="@+id/tvTaskFileName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="middle"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        tools:text="One_Piece_Episode_1_1080p.mp4" />

    <!-- Row 3: Progress Bar -->
    <ProgressBar
        android:id="@+id/pbTaskProgress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="45"
        android:progressTint="@color/accent_cyan" />

    <!-- Row 4: Status / Completion text & Action buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvTaskProgressText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent_cyan"
            android:textSize="12sp"
            tools:text="148.5 MB / 331.0 MB (45%)" />

        <Button
            android:id="@+id/btnTaskOpen"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_btn_primary"
            android:fontFamily="sans-serif-bold"
            android:paddingHorizontal="14dp"
            android:text="▶ Play"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:textSize="11sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btnTaskCancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_card"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="12dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="#FF4D4D"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
