<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="@drawable/tv_card_selector"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/server_settings_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Set the AniStream backend server address (default: http://rravi.ddns.net:4008 or custom LAN IP)"
        android:textColor="@color/tv_text_muted"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/etTvServerUrl"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/tv_button_selector"
        android:focusable="true"
        android:hint="http://rravi.ddns.net:4008"
        android:inputType="textUri"
        android:paddingHorizontal="16dp"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_muted"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelTvServer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveTvServer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:text="@string/save_server"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
