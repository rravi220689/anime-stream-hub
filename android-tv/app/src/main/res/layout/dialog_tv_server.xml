<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="540dp"
    android:layout_height="wrap_content"
    android:background="@drawable/tv_card_selector"
    android:orientation="vertical"
    android:padding="28dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-bold"
        android:text="@string/server_settings_title"
        android:textColor="@color/tv_text_primary"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Choose a quick preset or edit server address:"
        android:textColor="@color/tv_text_muted"
        android:textSize="13sp" />

    <!-- TV Remote Friendly Presets -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTvPresetDefault"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:text="Default (DDNS)"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnTvPresetEmulator"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:text="Emulator (10.0.2.2)"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_muted"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etTvServerUrl"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/tv_button_selector"
        android:focusable="true"
        android:hint="http://rravi.ddns.net:4008"
        android:inputType="textUri"
        android:paddingHorizontal="16dp"
        android:textColor="@color/tv_text_primary"
        android:textColorHint="@color/tv_text_muted"
        android:textSize="15sp" />

    <!-- Test Connection & Status Indicator -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTvTestServer"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:text="Test Connection"
            android:textAllCaps="false"
            android:textColor="@color/tv_focus_cyan"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvTvConnectionStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tv_text_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelTvServer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:text="@string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnSaveTvServer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:text="@string/save_server"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
