<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg">

    <!-- Top TV Navigation Bar -->
    <LinearLayout
        android:id="@+id/tvNavBar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#E6080B12"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="48dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="ANISTREAM "
            android:textColor="@color/tv_focus_cyan"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="TV"
            android:textColor="@color/tv_focus_purple"
            android:textSize="22sp" />

        <!-- TV Menu Items (Focusable with D-pad) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/navTvHome"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/tv_button_selector"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:text="@string/nav_home"
                android:textAllCaps="false"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/navTvTrending"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/tv_button_selector"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:text="@string/nav_trending"
                android:textAllCaps="false"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/navTvCartoons"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/tv_button_selector"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:text="@string/nav_cartoons"
                android:textAllCaps="false"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/navTvMovies"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginHorizontal="8dp"
                android:background="@drawable/tv_button_selector"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:paddingHorizontal="16dp"
                android:text="@string/nav_movies"
                android:textAllCaps="false"
                android:textColor="@color/tv_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Settings Button -->
        <Button
            android:id="@+id/navTvSettings"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/tv_button_selector"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:text="@string/nav_settings"
            android:textAllCaps="false"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Main TV Content (Hero Spotlight + Rails) -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/tvScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvNavBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Spotlight Banner (16:9 Widescreen Backdrop) -->
            <FrameLayout
                android:id="@+id/tvHeroContainer"
                android:layout_width="match_parent"
                android:layout_height="320dp">

                <ImageView
                    android:id="@+id/ivTvHeroBackdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Hero Backdrop"
                    android:scaleType="centerCrop"
                    tools:src="@color/tv_card" />

                <!-- Left Dark Gradient for Text Legibility -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/tv_hero_gradient" />

                <!-- Hero Meta Overlay -->
                <LinearLayout
                    android:layout_width="600dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingHorizontal="48dp">

                    <TextView
                        android:id="@+id/tvHeroTag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#4D00F0FF"
                        android:fontFamily="sans-serif-bold"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="⚡ FEATURED PREMIERE"
                        android:textColor="@color/tv_focus_cyan"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvHeroTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="2"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="28sp"
                        tools:text="Solo Leveling: Arise" />

                    <TextView
                        android:id="@+id/tvHeroDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="3"
                        android:textColor="@color/tv_text_secondary"
                        android:textSize="13sp"
                        tools:text="In a world where hunters must battle deadly monsters to protect mankind, the weakest hunter discovers the path to limitless power." />

                    <!-- Hero Actions (Focusable on TV) -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTvHeroPlay"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:background="@drawable/tv_button_selector"
                            android:focusable="true"
                            android:fontFamily="sans-serif-bold"
                            android:paddingHorizontal="24dp"
                            android:text="▶ Watch Now"
                            android:textAllCaps="false"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/btnTvHeroWatchlist"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="14dp"
                            android:background="@drawable/tv_button_selector"
                            android:focusable="true"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="20dp"
                            android:text="+ Watchlist"
                            android:textAllCaps="false"
                            android:textColor="@color/tv_text_primary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- Rail 1: Trending Anime -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="20dp"
                android:fontFamily="sans-serif-bold"
                android:text="🔥 Trending Anime Series"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTvTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="48dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_tv_card" />

            <!-- Rail 2: Popular Classics & New Hits -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-bold"
                android:text="⭐ Most Popular Hits"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTvPopular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="48dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_tv_card" />

            <!-- Rail 3: Curated Cartoons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-bold"
                android:text="🐱 Classic Cartoons &amp; Animation"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTvCartoons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="48dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_tv_card" />

            <!-- Rail 4: Feature Films -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:layout_marginTop="24dp"
                android:fontFamily="sans-serif-bold"
                android:text="🎬 Feature Animated Movies"
                android:textColor="@color/tv_text_primary"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTvMovies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="24dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="48dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_tv_card" />

            <!-- Universal D-pad Focusable TV Pagination Bar -->
            <LinearLayout
                android:id="@+id/tvPaginationContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingVertical="16dp"
                android:layout_marginBottom="48dp">

                <Button
                    android:id="@+id/btnTvPrevPage"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/tv_button_selector"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="24dp"
                    android:text="‹ Prev Page"
                    android:textAllCaps="false"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTvPageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:fontFamily="sans-serif-bold"
                    android:text="Page 1"
                    android:textColor="@color/tv_focus_cyan"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnTvNextPage"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:background="@drawable/tv_button_selector"
                    android:focusable="true"
                    android:fontFamily="sans-serif-bold"
                    android:paddingHorizontal="24dp"
                    android:text="Next Page ›"
                    android:textAllCaps="false"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- TV Loading Indicator -->
    <ProgressBar
        android:id="@+id/tvProgressBar"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/tv_focus_cyan"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
